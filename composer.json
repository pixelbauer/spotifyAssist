{
  "name": "spotify-assist/app",
  "description": "Spotify Assist Application",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "symfony/console": "^7.0",
    "symfony/http-foundation": "^7.0",
    "symfony/routing": "^7.0",
    "doctrine/dbal": "^3.7",
    "twig/twig": "^3.8",
    "sammyjo20/saloon": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^1.10",
    "phpstan/phpstan-symfony": "^1.3",
    "phpstan/phpstan-doctrine": "^1.3"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse",
    "check": [
      "@test",
      "@analyse"
    ]
  }
}
