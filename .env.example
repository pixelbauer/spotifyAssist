# Application
APP_NAME=Spotify Assist
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080

# Database
DB_DRIVER=pdo_mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=spotifyassist
DB_USERNAME=app
DB_PASSWORD=app

# Spotify API
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=http://localhost:8080/spotify/callback
