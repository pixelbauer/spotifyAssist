{% extends 'layouts/base.html.twig' %}

{% block title %}{{ title }} - Spotify Assist{% endblock %}

{% block content %}
<div class="max-w-3xl mx-auto">
    <h1 class="text-4xl font-bold text-gray-900 mb-6">Über Spotify Assist</h1>

    <div class="bg-white rounded-lg shadow-md p-8">
        <p class="text-lg text-gray-700 mb-4">
            Spotify Assist ist eine moderne Webanwendung zur Verwaltung und Analyse deiner Spotify-Inhalte.
        </p>

        <h2 class="text-2xl font-semibold text-gray-900 mt-6 mb-4">Technologien</h2>
        <ul class="list-disc list-inside text-gray-700 space-y-2">
            <li>PHP 8.5</li>
            <li>Symfony Components</li>
            <li>Doctrine DBAL</li>
            <li>Twig Template Engine</li>
            <li>Tailwind CSS</li>
            <li>Spotify Web API</li>
        </ul>

        <h2 class="text-2xl font-semibold text-gray-900 mt-6 mb-4">Features</h2>
        <ul class="list-disc list-inside text-gray-700 space-y-2">
            <li>Musik-Suche</li>
            <li>Playlist-Verwaltung</li>
            <li>Wiedergabe-Steuerung</li>
            <li>Statistiken und Analysen</li>
        </ul>
    </div>
</div>
{% endblock %}
