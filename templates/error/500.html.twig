{% extends 'layouts/base.html.twig' %}

{% block title %}Serverfehler - Spotify Assist{% endblock %}

{% block content %}
<div class="text-center py-12">
    <h1 class="text-6xl font-bold text-gray-900 mb-4">500</h1>
    <h2 class="text-2xl font-semibold text-gray-700 mb-4">Interner Serverfehler</h2>
    <p class="text-gray-600 mb-8">Es ist ein Fehler aufgetreten. Bitte versuche es später erneut.</p>

    {% if error is defined %}
        <div class="bg-red-50 border border-red-200 rounded-lg p-4 max-w-2xl mx-auto text-left mb-4">
            <p class="font-mono text-sm text-red-800">{{ error }}</p>
        </div>
    {% endif %}

    <a href="/" class="inline-block bg-green-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-green-700 transition-colors">
        Zurück zur Startseite
    </a>
</div>
{% endblock %}
